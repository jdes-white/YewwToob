# Postgres connection string.
DATABASE_URL=
# Which Prisma driver adapter to use: "neon" (default, Neon's WebSocket
# serverless driver) or "pg" (standard node-postgres, for any regular
# Postgres — e.g. Render Postgres, used for the Phase 0 real-integration
# proof run while no Neon project was available).
DATABASE_ADAPTER=neon

# Primary transcript provider.
FREE_TRANSCRIPT_API_KEY=
# Optional override if FreeTranscriptAPI's base URL differs from the default
# baked into lib/transcript/freeTranscriptApi.ts.
FREE_TRANSCRIPT_API_BASE_URL=

# Fallback transcript provider. Must only be used in native-caption mode
# (enforced in code via mode=native) — never speech-to-text.
SUPADATA_API_KEY=
SUPADATA_API_BASE_URL=

# Anthropic API key used for structured analysis extraction.
ANTHROPIC_API_KEY=
# Optional override of the analysis model (defaults to Haiku for cost control).
ANTHROPIC_ANALYSIS_MODEL=
