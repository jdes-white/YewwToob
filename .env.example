# Postgres connection string.
DATABASE_URL=
# Which Prisma driver adapter to use: "neon" (default, Neon's WebSocket
# serverless driver) or "pg" (standard node-postgres, for any regular
# Postgres — e.g. Render Postgres, used for the Phase 0 real-integration
# proof run while no Neon project was available).
DATABASE_ADAPTER=neon

# Primary transcript provider — FreeTranscriptAPI.com. No API key or signup
# is required for its free tier (50 requests/hour/IP); set this only to use
# the higher-limit authenticated tier.
FREE_TRANSCRIPT_API_KEY=
# Optional override if FreeTranscriptAPI's base URL differs from the default
# baked into lib/transcript/freeTranscriptApi.ts.
FREE_TRANSCRIPT_API_BASE_URL=

# Fallback transcript provider. Must only be used in native-caption mode
# (enforced in code via mode=native) — never speech-to-text.
SUPADATA_API_KEY=
SUPADATA_API_BASE_URL=

# OpenAI API key used for structured analysis extraction.
OPENAI_API_KEY=
# Optional override of the analysis model (defaults to the cheapest current
# model that reliably completes structured extraction — see lib/llm/openai.ts).
OPENAI_ANALYSIS_MODEL=

# Minimal access gate (HTTP Basic Auth, see proxy.ts): this is a personal app
# whose routes trigger paid requests, so both must be set in any environment
# reachable on a public URL. Left unset, the app is NOT gated (fine for local
# dev only).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
